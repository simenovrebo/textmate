#!/bin/sh
# Check dependencies, build vendored libraries, write ‘local.rave’ (unless it exists) and generate ‘build.ninja’.
#
# Usage: ./configure [--universal]
#
#   --universal  Build release binaries for both arm64 and x86_64 (default is the architecture of this Mac)
#
# The build directory defaults to ‘~/build/<name of source directory>’ and can be changed by setting ‘builddir’.

function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

universal=
for arg in "$@"; do
	case "$arg" in
		--universal) universal=1 ;;
		*)           error "*** unknown option: ‘${arg}’." ;;
	esac
done

builddir=${builddir:-$HOME/build/$(basename "$PWD")}
min_os=$(sed -n 's/^set APP_MIN_OS *"\(.*\)"/\1/p' default.rave)

# ===============================
# = Check required dependencies =
# ===============================

# Homebrew (/opt/homebrew on Apple silicon, /usr/local on Intel) or MacPorts (/opt/local)
prefixes=
command -v brew >/dev/null && prefixes="$(brew --prefix)"
for prefix in /opt/homebrew /opt/local /usr/local; do
	case " $prefixes " in *" $prefix "*) ;; *) [[ -d "$prefix/include" ]] && prefixes="$prefixes $prefix" ;; esac
done

for prefix in $prefixes; do PATH="$PATH:$prefix/bin"; done

missing=
for dep in cmake ninja ragel multimarkdown pgrep pkill; do
	command -v "$dep" >/dev/null || missing="$missing ${dep}"
done

include_prefix=
for prefix in $prefixes; do
	if [[ -f "$prefix/include/boost/crc.hpp" && -f "$prefix/include/boost/variant.hpp" && -f "$prefix/include/sparsehash/dense_hash_map" ]]; then
		include_prefix=$prefix
		break
	fi
done
[[ -n "$include_prefix" ]] || missing="$missing boost sparsehash"

if [[ -n "$missing" ]]; then
	error "*** dependencies missing:${missing}

Install using Homebrew:

    brew install boost cmake google-sparsehash multimarkdown ninja ragel

Or MacPorts:

    sudo port install boost cmake multimarkdown ninja ragel sparsehash"
fi

[[ -f vendor/capnp/vendor/c++/CMakeLists.txt ]] || error "*** submodules missing, run: git submodule update --init --recursive"

# ==============================
# = Build vendored Cap’n Proto =
# ==============================

capnp_prefix="$builddir/vendor/capnp"
vendor/capnp/build.sh "$capnp_prefix" "$min_os" || error "*** failed to build Cap’n Proto."

# ======================
# = Write ‘local.rave’ =
# ======================

if [[ -e local.rave ]]; then
	echo >&2 "Skipping writing ‘local.rave’: File already exists"
else
	{
		echo "# Generated by ./configure $*"
		echo "add FLAGS    \"-I${capnp_prefix}/include -I${include_prefix}/include\""
		echo "add LN_FLAGS \"-L${capnp_prefix}/lib\""
		echo "set CAPNP_BIN \"${capnp_prefix}/bin\""
		if [[ -n "$universal" ]]; then
			echo
			echo 'config release {'
			echo '	arch "arm64" "x86_64" {'
			echo '		add FLAGS    "-arch ${arch}"'
			echo '		add LN_FLAGS "-arch ${arch}"'
			echo '	}'
			echo '}'
		fi
	} > local.rave~ && mv local.rave~ local.rave
fi

# ========================
# = Generate build files =
# ========================

bin/rave -crelease -tTextMate -b"$builddir"
