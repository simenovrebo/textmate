#!/bin/sh
# Run a test runner and fail if it has not finished after TEST_TIMEOUT seconds (default 120).
#
# Usage: run_test <test runner> [arguments]

timeout=${TEST_TIMEOUT:-120}

"$@" &
pid=$!

# The watchdog reports via fd 3, its own stderr is silenced to avoid job notices when it is stopped
exec 3>&2
(
	sleep "$timeout"
	if kill -9 $pid 2>/dev/null; then
		echo >&3 "*** $(basename "$1"): killed after ${timeout} seconds (set TEST_TIMEOUT to change)"
	fi
) 2>/dev/null &
watchdog=$!

wait $pid
rc=$?

pkill -P $watchdog 2>/dev/null
kill $watchdog 2>/dev/null
exit $rc
